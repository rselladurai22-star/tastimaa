# --- Core ---------------------------------------------------------------
DATABASE_URL=postgres://gsi:gsi@localhost:5432/gsi
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Grammar Atlas"
# 32+ random characters, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=
# Bearer token required by /api/cron/* (scheduled data refreshes).
CRON_SECRET=
# Proxies in front of the app that append to X-Forwarded-For (rate limiting
# keys on the address the outermost trusted proxy saw). 1 = one reverse proxy
# or platform edge; 2 = e.g. CDN + load balancer.
TRUSTED_PROXY_HOPS=1

# --- Optional integrations ---------------------------------------------
# Enables the LLM-written answers in the School Intelligence Assistant.
# Without it the assistant runs in retrieval-only mode (still cited).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Transactional email (magic links, reminders). Without it emails are logged.
RESEND_API_KEY=
EMAIL_FROM="Grammar Atlas <no-reply@example.com>"
# Map style (MapLibre). Default: OpenFreeMap Positron (no key required).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Data ingestion -----------------------------------------------------
STORAGE_DIR=./storage
POSTCODES_IO_BASE_URL=https://api.postcodes.io
# Northern Ireland postcode data carries Land & Property Services licence
# restrictions. Only enable after confirming your use is permitted.
NI_POSTCODES_ENABLED=false
ETL_USER_AGENT="GrammarAtlasBot/0.1 (+https://example.com/methodology)"
LOG_LEVEL=info
